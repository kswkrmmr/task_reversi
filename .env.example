# Copy this file to `.env`.
# ローカルDB（docker compose up -d db）への接続文字列。
DATABASE_URL="postgresql://taskreversi:taskreversi@localhost:5434/taskreversi_dev"

# Auth.js のセッション署名用シークレット。例: `npx auth secret` または `openssl rand -base64 33`
AUTH_SECRET="replace-with-a-random-secret"

# GitHub OAuth App のクライアントID/シークレット
# コールバックURL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# "true" にすると開発環境（NODE_ENV!=production）でのみ、名前を入れるだけの開発用ログインが有効になる。
AUTH_DEV_LOGIN="true"
